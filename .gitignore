# API Secrets
.env

# Python caching
__pycache__/
*.pyc
*.pyo

# Virtual Environments
venv/
env/
.venv/
.env/

# Stop accidental PII leaks by ignoring all raw email files
*.eml
*.msg

# Except the synthetic corpus in samples/ — note the ** is required, a bare
# samples/*.eml does not reach the malicious/ clean/ edge/ subdirectories and
# silently drops them from commits.
!samples/**/*.eml
!samples/**/*.msg
!samples/*.eml
!samples/*.msg

# Build artifacts and reports
reports/

# Vendored dependencies
deps/
